    "@types/node-fetch": "2.6.2",
    "@types/unzipper": "0.10.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "eslint": "10.9.1",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-jest": "29.16.5",
    "express": "5.2.1",
    "get-port": "7.2.0",
